{
    "name": "jgodstime/laravel-error-notifier",
    "description": "Email and Slack notifications for uncaught exceptions in a Laravel application, with an optional user feedback form on the 500 page.",
    "type": "library",
    "keywords": ["jgodstime", "laravel", "error", "exception", "notifier", "slack", "email"],
    "homepage": "https://github.com/jgodstime/laravel-error-notifier",
    "license": "MIT",
    "authors": [
        {
            "name": "Godstime John",
            "email": "jgodstime10@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/jgodstime/laravel-error-notifier/issues",
        "source": "https://github.com/jgodstime/laravel-error-notifier"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5|^8.0",
        "guzzlehttp/promises": "^2.0|^3.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/phpstan": "^1.12|^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.0|^2.0",
        "phpstan/phpstan-phpunit": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErrorNotifier\\Notify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErrorNotifier\\Notify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ErrorNotifier\\Notify\\ErrorNotifierServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "ignore"
        },
        "policy": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
